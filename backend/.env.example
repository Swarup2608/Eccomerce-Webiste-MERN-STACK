PORT=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

MONGODB_URI=

STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=

JWT_SECRET_KEY=

# One-time bootstrap only: on first boot, if no admin account exists yet in
# the database, these are used to seed one (bcrypt-hashed) into the `admin`
# collection. After that first boot, login always checks the database, not
# these env vars — they can be safely removed. To add a second admin later,
# insert a document into the `admin` collection directly with a bcrypt hash:
#   node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)"
#   then insert { email, password: <hash>, role: 'admin' } via mongosh/Compass.
ADMIN_EMAIL=
ADMIN_PASSWORD=